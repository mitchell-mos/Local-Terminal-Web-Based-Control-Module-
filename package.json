{
  "name": "control-module",
  "version": "1.3.3",
  "description": "A private, local-only dashboard for starting and stopping development projects.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1 --port 1025",
    "build": "vinext build",
    "start": "vinext start --hostname 127.0.0.1 --port 1025",
    "version:bump": "node support/version.mjs bump",
    "version:check": "node support/version.mjs check",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "oxlint --deny-warnings app lib server support/version.mjs support/tests proxy.ts next.config.ts vite.config.ts",
    "test:unit": "node --test support/tests/*.test.*",
    "test:python": "python3 -B -m unittest discover -s support/tests -p 'test_*.py'",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run test:python"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.32",
    "fast-check": "4.9.0",
    "oxlint": "1.76.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.0"
  },
  "type": "module"
}
